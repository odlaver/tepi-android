    <string name="tour_done">Start using Tepi</string>
    <string name="tour1_title">An island around your camera</string>
    <string name="tour1_body">Tepi sits at the camera and grows when something happens: a song, a message, a call, a download, a timer, or prayer time.</string>
    <string name="tour2_title">Tap, swipe, hold</string>
    <string name="tour2_body">Tap the island to open it. Swipe down for the panel, up to close, sideways to switch tabs. Hold for quick actions like timers, notes, and Bank mode.</string>
    <string name="tour3_title">Make it yours</string>
    <string name="tour3_body">Choose how Tepi looks when nothing is happening. You can change this, the glass, and the colours later in Appearance.</string>
    <string name="tour4_title">Fits your camera</string>
    <string name="tour4_body">If the island doesn\'t line up with your camera, open Camera alignment and move it until it fits.</string>
    <string name="tour5_title">Works with your laptop</string>
    <string name="tour5_body">With Tepi for Windows, answer coding agents, copy codes, and send files between phone and laptop. Connect from Integrations, Laptop.</string>
    <string name="tour6_title">Light by design</string>
    <string name="tour6_body">No account, no ads, no analytics. Tepi draws nothing while idle and only needs the permissions on the next screen.</string>
    <string name="update_channel">Tepi updates</string>
    <string name="update_tap">Tap to download the new APK</string>
    <string name="update_notify">Tell me about new versions</string>
    <string name="update_notify_sub">Checks GitHub once a day, shows it in the island and the notification shade</string>
    <string name="update_check">Check for updates</string>
    <string-array name="whats_new">
        <item>The island grows out of the camera and settles back without a pop</item>
        <item>Choose how Tepi looks when idle: a pill around the camera, a battery ring, or hidden</item>
        <item>Liquid glass and Frost, opacity, theme, and accent colours, including one from the song cover</item>
